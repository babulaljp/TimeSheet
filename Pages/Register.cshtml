@page
@model UEAW.Pages.RegisterModel
@{
    ViewData["Title"] = "User Registration";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>Register</h2>
        <form method="post">
            <div class="mb-3">
                <label asp-for="UM.UserName" class="form-label"></label>
                <input asp-for="UM.UserName" class="form-control" />
                <span asp-validation-for="UM.UserName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UM.Password" class="form-label"></label>
                <input asp-for="UM.Password" class="form-control" type="password" />
                <span asp-validation-for="UM.Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UM.FirstName" class="form-label"></label>
                <input asp-for="UM.FirstName" class="form-control" />
                <span asp-validation-for="UM.FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UM.LastName" class="form-label"></label>
                <input asp-for="UM.LastName" class="form-control" />
                <span asp-validation-for="UM.LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UM.Email" class="form-label"></label>
                <input asp-for="UM.Email" class="form-control" />
                <span asp-validation-for="UM.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Register</button>
            <label asp-for="UM.ErrorMessage" class="form-label"></label>
        </form>
         

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
