@page
@model Timesheet.Pages.CaptureTimeModel
@{
    ViewData["Title"] = "Capture Time";
}

<h2>Capture Time</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            

            <div class="mb-3">
                <label for="project" class="form-label">Project</label>
                <select id="projectid" name="projectid" class="form-control">
                    <option value="">-- Select project --</option>
                    @if (Model.ProjectOptions != null)
                    {
                        foreach (var p in Model.ProjectOptions)
                        {
                            <option value="@p.Value">@p.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="task" class="form-label">Task</label>
                <select id="taskid" name="taskid" class="form-control">
                    <option value="">-- Select task --</option>
                    @if (Model.TaskOptions != null)
                    {
                        foreach (var t in Model.TaskOptions)
                        {
                            <option value="@t.Value">@t.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="details" class="form-label">Details</label>
                <textarea id="details" name="details" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label for="dateInput" class="form-label">Date</label>
                <input type="date" id="dateInput" name="date" class="form-control" asp-for="CT.Date" />
            </div>

            <div class="mb-3">
                <label for="hours" class="form-label">Hours Worked</label>
                <input type="number" step="0.25" id="hours" name="HoursWorked" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>

    
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                selectable: true,
                dateClick: function (info) {
                    // when a date is clicked, set the date input value
                    var dateInput = document.getElementById('dateInput');
                    if (dateInput) {
                        dateInput.value = info.dateStr;
                    }
                }
            });
            calendar.render();
        });
    </script>
}
